<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RuntimeFrameworkVersion>10.0.14</RuntimeFrameworkVersion>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <AssemblyName>Heimora</AssemblyName>
    <Version>0.7.1</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <Content Include="vendor\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="README.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="SECURITY-REVIEW.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="CENTRAL-SECURITY-DESIGN.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="NAME-AND-BRANDING.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="assets\app-icon.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="languages\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
